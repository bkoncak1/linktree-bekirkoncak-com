{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linktree-bekirkoncak-com-site",
  "compatibility_date": "2026-05-14",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "CLICKS",
      "dataset": "linktree_clicks"
    }
  ],
  "routes": [
    {
      "pattern": "linktree.bekirkoncak.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
