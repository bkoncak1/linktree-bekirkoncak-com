---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import LinkButton from "../components/LinkButton.astro";

const entry = await getEntry("profile", "main");
if (!entry) {
  throw new Error("profile.yaml not found or empty");
}
const { name, handle, bio, avatar, links, analytics } = entry.data;

const pageTitle = handle ? `${name} (${handle})` : name;

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const linksWithSlugs = links.map((l) => ({
  ...l,
  slug: l.slug ?? slugify(l.title),
}));
---

<Layout
  title={pageTitle}
  description={bio}
  cloudflareAnalyticsToken={analytics?.cloudflareToken}
>
  <main class="mx-auto flex min-h-screen w-full max-w-md flex-col px-5 py-10 sm:py-16">
    <header class="flex flex-col items-center text-center">
      {
        avatar && (
          <img
            src={avatar}
            alt={name}
            width="96"
            height="96"
            class="mb-4 h-24 w-24 rounded-full border border-neutral-800 bg-neutral-900 object-cover"
          />
        )
      }
      <h1 class="text-xl font-semibold tracking-tight text-white sm:text-2xl">
        {name}
      </h1>
      {
        handle && (
          <p class="mt-1 text-sm text-neutral-500">{handle}</p>
        )
      }
      {
        bio && (
          <p class="mt-3 max-w-sm text-sm text-neutral-300">{bio}</p>
        )
      }
    </header>

    <nav class="mt-8 flex flex-col gap-2.5" aria-label="Links">
      {linksWithSlugs.map((link) => <LinkButton {...link} />)}
    </nav>

    <footer class="mt-auto pt-12 text-center text-xs text-neutral-600">
      <a
        href="https://bkir.dev"
        class="hover:text-neutral-400"
      >
        bkir.dev
      </a>
    </footer>
  </main>

  <script>
    // Per-link click tracking via Cloudflare Web Analytics SPA hooks.
    // We push a virtual pageview to /out/<slug>, then restore the URL.
    // The beacon picks up the history change and records it as a pageview.
    const links = document.querySelectorAll<HTMLAnchorElement>(
      "a.link-item[data-slug]"
    );
    for (const link of links) {
      link.addEventListener("click", () => {
        const slug = link.dataset.slug;
        if (!slug) return;
        try {
          history.pushState({}, "", `/out/${slug}`);
          requestAnimationFrame(() => {
            history.replaceState({}, "", "/");
          });
        } catch {
          // ignore — analytics is best-effort
        }
      });
    }
  </script>
</Layout>
